#cloud-config
# Configuración inicial de la instancia de base de datos (primer arranque).
hostname: ${hostname}
fqdn: ${hostname}
manage_etc_hosts: true
timezone: America/La_Paz

package_update: true
packages:
  - acl      # permite a Ansible usar become_user (postgres)
  - rsync

write_files:
  # PostgreSQL escucha en la red privada (no solo en localhost)
  - path: /etc/postgresql/16/main/conf.d/90-asistencia.conf
    permissions: "0644"
    content: |
      listen_addresses = '*'
      timezone = 'America/La_Paz'
      log_timezone = 'America/La_Paz'
  # Solo el usuario de la app, sobre su base, desde la VPC y con contraseña
  - path: /etc/postgresql/16/main/pg_hba.conf
    append: true
    content: |
      # asistencia (cloud-init)
      host    ${db_name}    ${db_user}    ${vpc_cidr}    scram-sha-256
  # Crea usuario y base (idempotente). Las credenciales no quedan en la AMI.
  - path: /usr/local/sbin/asistencia-crear-bd.sh
    permissions: "0700"
    content: |
      #!/bin/bash
      set -euo pipefail
      until pg_isready -q; do sleep 1; done
      sudo -u postgres psql -v ON_ERROR_STOP=1 <<'SQL'
      DO $$ BEGIN
        IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${db_user}') THEN
          CREATE ROLE ${db_user} LOGIN PASSWORD '${db_password}';
        ELSE
          ALTER ROLE ${db_user} WITH LOGIN PASSWORD '${db_password}';
        END IF;
      END $$;
      SQL
      if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname='${db_name}'" | grep -q 1; then
        sudo -u postgres createdb -O ${db_user} -E UTF8 -T template0 ${db_name}
      fi
      echo "Base ${db_name} lista para ${db_user}"

runcmd:
  - systemctl restart postgresql
  - /usr/local/sbin/asistencia-crear-bd.sh

final_message: "cloud-init bd terminado en $UPTIME s"
