# {{ ansible_managed }}
[server]
http_port = 3000

[security]
admin_user = admin
disable_gravatar = true
cookie_samesite = lax

[users]
allow_sign_up = false
default_theme = system

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false

[dashboards]
default_home_dashboard_path = /var/lib/grafana/dashboards/tenants.json
