    {
      "id": 8,
      "title": "Latencia del backend",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-central"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-central"
          },
          "expr": "histogram_quantile(0.50, sum by (tenant, le) (rate(django_http_requests_latency_seconds_by_view_method_bucket{tenant=~\"$tenant\", entorno=~\"$entorno\"}[$__rate_interval])))",
          "legendFormat": "{{tenant}} p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-central"
          },
          "expr": "histogram_quantile(0.95, sum by (tenant, le) (rate(django_http_requests_latency_seconds_by_view_method_bucket{tenant=~\"$tenant\", entorno=~\"$entorno\"}[$__rate_interval])))",
          "legendFormat": "{{tenant}} p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Peticiones por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-central"
      },
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-central"
          },
          "expr": "sum by (tenant) (rate(django_http_requests_total_by_method_total{tenant=~\"$tenant\", entorno=~\"$entorno\"}[$__rate_interval]))",
          "legendFormat": "{{tenant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Errores del backend (5xx)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-central"
      },
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-central"
          },
          "expr": "sum by (tenant) (rate(django_http_responses_total_by_status_total{status=~\"5..\", tenant=~\"$tenant\", entorno=~\"$entorno\"}[$__rate_interval]))",
          "legendFormat": "{{tenant}} 5xx/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-central"
          },
          "expr": "100 * sum by (tenant) (rate(django_http_responses_total_by_status_total{status=~\"5..\", tenant=~\"$tenant\", entorno=~\"$entorno\"}[$__rate_interval])) / clamp_min(sum by (tenant) (rate(django_http_responses_total_by_status_total{tenant=~\"$tenant\", entorno=~\"$entorno\"}[$__rate_interval])), 0.001)",
          "legendFormat": "{{tenant}} % error"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
