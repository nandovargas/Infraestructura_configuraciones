# {{ ansible_managed }}
[Unit]
Description=Asistencia - API Django (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory={{ backend_dir }}/app
# 1 proceso con hilos: las métricas de django-prometheus quedan en un único proceso
ExecStart={{ backend_dir }}/venv/bin/gunicorn config.wsgi:application \
  --bind 0.0.0.0:8000 --workers 1 --threads {{ gunicorn_threads }} --timeout 120 \
  --access-logfile - --error-logfile -
Restart=on-failure

[Install]
WantedBy=multi-user.target
