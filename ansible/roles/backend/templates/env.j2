# {{ ansible_managed }}
SECRET_KEY={{ django_secret_key }}
DEBUG=False
ALLOWED_HOSTS={{ backend_public_ip }},{{ backend_private_ip }},localhost,127.0.0.1

# Motor instrumentado: métricas de consultas y errores de BD en /metrics
DB_ENGINE=django_prometheus.db.backends.postgresql
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_HOST={{ bd_private_ip }}
DB_PORT=5432

# URL del tenant (subdominio con su identificador) y acceso directo por IP
CORS_ALLOWED_ORIGINS={{ frontend_url }},http://{{ frontend_public_ip }}
JWT_HORAS=8

# Límites del plan {{ plan }} (0 = sin límite)
PLAN_MAX_ESTUDIANTES={{ max_estudiantes }}
